@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Treino";
}

@model ExcluirTreinoViewModel

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
      method="post">
    <input asp-for="Id" type="hidden">
    <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mb-3"></div>

    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        Deseja realmente excluir este treino?
    </div>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input asp-for="Nome" class="form-control" readonly>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-danger rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
