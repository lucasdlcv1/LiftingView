@{
    Layout = "_Layout";
    ViewBag.Titulo = "Novo registro";
}

@model RegistroViewModel

<form class="card border-primary-subtle shadow-sm p-4 mb-4" asp-action="Cadastrar" method="get">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <label asp-for="TreinoId" class="form-label fw-semibold">Treino para usar como modelo</label>
    <div class="d-flex flex-column flex-sm-row gap-2">
        <select asp-for="TreinoId" class="form-select">
            <option value="">Selecione um treino</option>
            @foreach (TreinoDto treino in (List<TreinoDto>)ViewBag.Treinos)
            {
                if (treino.Id == Model.TreinoId)
                {
                    <option value="@treino.Id" selected>@treino.Nome</option>
                }
                else
                {
                    <option value="@treino.Id">@treino.Nome</option>
                }
            }
        </select>
        <button class="btn btn-outline-primary text-nowrap" type="submit">Aplicar treino</button>
    </div>
</form>

@if (Model.TreinoId.HasValue)
{
    <form class="card border-primary-subtle shadow-sm p-4" asp-action="Cadastrar" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="TreinoId" type="hidden">

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label asp-for="Data" class="form-label fw-semibold">Dia do registro</label>
                <input asp-for="Data" type="date" class="form-control">
                <span asp-validation-for="Data" class="text-danger small"></span>
            </div>
            <div class="col-md-8">
                <label class="form-label fw-semibold">Treino aplicado</label>
                <input class="form-control" value="@Model.TreinoNome" readonly>
            </div>
        </div>

        <h3 class="h5 mb-3">Exercícios realizados</h3>
        @if (Model.ItensRegistro.Count == 0)
        {
            <p class="text-body-secondary">Este treino não possui exercícios cadastrados.</p>
        }
        else
        {
            @for (int i = 0; i < Model.ItensRegistro.Count; i++)
            {
                <section class="border rounded-3 p-3 mb-3">
                    <div class="mb-3">
                        <label asp-for="ItensRegistro[i].ExercicioId" class="form-label">Exercício</label>
                        <select asp-for="ItensRegistro[i].ExercicioId" class="form-select">
                            <option value="">Selecione um exercício</option>
                            @foreach (ExercicioDto exercicio in (List<ExercicioDto>)ViewBag.Exercicios)
                            {
                                if (exercicio.Id == Model.ItensRegistro[i].ExercicioId)
                                {
                                    <option value="@exercicio.Id" selected>@exercicio.Nome</option>
                                }
                                else
                                {
                                    <option value="@exercicio.Id">@exercicio.Nome</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ItensRegistro[i].ExercicioId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-4">
                            <label asp-for="ItensRegistro[i].SeriesRealizadas" class="form-label">Séries</label>
                            <input asp-for="ItensRegistro[i].SeriesRealizadas" class="form-control" type="number" min="1">
                            <span asp-validation-for="ItensRegistro[i].SeriesRealizadas" class="text-danger small"></span>
                        </div>
                        <div class="col-4">
                            <label asp-for="ItensRegistro[i].RepeticoesRealizadas" class="form-label">Repetições</label>
                            <input asp-for="ItensRegistro[i].RepeticoesRealizadas" class="form-control" type="number" min="1">
                            <span asp-validation-for="ItensRegistro[i].RepeticoesRealizadas" class="text-danger small"></span>
                        </div>
                        <div class="col-4">
                            <label asp-for="ItensRegistro[i].CargaUtilizada" class="form-label">Carga (kg)</label>
                            <input asp-for="ItensRegistro[i].CargaUtilizada" class="form-control" type="number" min="0">
                            <span asp-validation-for="ItensRegistro[i].CargaUtilizada" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="ItensRegistro[i].Observacoes" class="form-label">Observações do exercício</label>
                        <input asp-for="ItensRegistro[i].Observacoes" class="form-control">
                    </div>
                </section>
            }
        }

        <div class="mb-3">
            <label asp-for="Observacoes" class="form-label fw-semibold">Observações do registro</label>
            <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Observacoes" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-2">
            <a class="btn btn-outline-secondary rounded-pill px-4" asp-action="Listar">Cancelar</a>
            <button class="btn btn-primary rounded-pill px-4" type="submit">Salvar registro</button>
        </div>
    </form>
}
