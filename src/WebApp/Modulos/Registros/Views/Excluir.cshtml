@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir registro";
}

@model ExcluirRegistroViewModel

<div class="card border-danger-subtle shadow-sm mx-auto p-4" style="max-width: 620px;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <p>Deseja excluir o registro de <strong>@Model.Data.ToString("dd/MM/yyyy")</strong> do treino
        <strong>@(Model.TreinoNome ?? "removido")</strong>?</p>

    <form asp-action="Excluir" method="post">
        <input asp-for="Id" type="hidden">
        <input asp-for="Data" type="hidden">
        <input asp-for="TreinoNome" type="hidden">
        <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-outline-secondary rounded-pill px-4" asp-action="Listar">Cancelar</a>
            <button class="btn btn-danger rounded-pill px-4" type="submit">Excluir registro</button>
        </div>
    </form>
</div>
