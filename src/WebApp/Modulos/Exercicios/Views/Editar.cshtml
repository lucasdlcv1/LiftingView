@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edicao de Exercicio";
}

@model EditarExercicioViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar"
      method="post">
    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome do Exercicio</label>
        <input asp-for="Nome" type="text" class="form-control">
        <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label fw-semibold text-primary text-uppercase small">Descricao
            Exercico</label>
            <input asp-for="Descricao" type="text" class="form-control">
            <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
        </div>

    </div>

    <div class="mb-3">
        <label asp-for="GrupoMuscular" class="form-label fw-semibold text-primary text-uppercase small">Grupo
            Muscular</label>
            <input asp-for="GrupoMuscular" type="text" class="form-control">
            <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
            <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
        </div>
    </form>
