<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    @* Importação do CSS do Bootstrap *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <title>@ViewBag.Titulo - LiftingView</title>
</head>

<body>
    @* Barra de Navegação *@
    <nav class="navbar navbar-expand-lg bg-white border-bottom">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">LiftingView</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Início</a>
                    <a class="nav-link" asp-controller="Exercicio" asp-action="Listar">Exercicios</a>
                    <a class="nav-link" asp-controller="Treino" asp-action="Listar">Treinos</a>
                    <a class="nav-link" asp-controller="Registro" asp-action="Listar">Registros</a>
                </div>
            </div>
        </div>
    </nav>

    @* Cabeçalho da Página *@
    <header class="container py-4">
        <h2>@ViewBag.Titulo</h2>
    </header>

    @* Conteúdo da Página *@
    <main class="container pb-5">
        @RenderBody()
    </main>

    @* Importação do JavaScript do Bootstrap *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
    <script>
        (() => {
            document.querySelectorAll("[data-sortable-list]").forEach(container => {
                let draggedItem = null;

                const updateOrder = () => {
                    const items = [...container.querySelectorAll(":scope > [data-sortable-item]")];
                    items.forEach((item, index) => {
                        const orderInput = item.querySelector("[data-order-input]");
                        const orderLabel = item.querySelector("[data-order-label]");
                        const moveUp = item.querySelector("[data-move-up]");
                        const moveDown = item.querySelector("[data-move-down]");

                        if (orderInput)
                            orderInput.value = String(index + 1);
                        if (orderLabel)
                            orderLabel.textContent = String(index + 1);
                        if (moveUp)
                            moveUp.disabled = index === 0;
                        if (moveDown)
                            moveDown.disabled = index === items.length - 1;
                    });
                };

                container.addEventListener("click", event => {
                    const target = event.target instanceof Element ? event.target : null;
                    const moveUp = target?.closest("[data-move-up]");
                    const moveDown = target?.closest("[data-move-down]");
                    const item = target?.closest("[data-sortable-item]");

                    if (!item)
                        return;

                    if (moveUp && item.previousElementSibling)
                        container.insertBefore(item, item.previousElementSibling);
                    else if (moveDown && item.nextElementSibling)
                        container.insertBefore(item.nextElementSibling, item);
                    else
                        return;

                    updateOrder();
                });

                container.addEventListener("dragstart", event => {
                    const target = event.target instanceof Element ? event.target : null;
                    if (!target?.closest("[data-drag-handle]"))
                        return;

                    draggedItem = target.closest("[data-sortable-item]");
                    if (!draggedItem)
                        return;

                    event.dataTransfer.effectAllowed = "move";
                    event.dataTransfer.setData("text/plain", "");
                    draggedItem.classList.add("opacity-50");
                });

                container.addEventListener("dragover", event => {
                    if (!draggedItem)
                        return;

                    const target = event.target instanceof Element ? event.target : null;
                    const targetItem = target?.closest("[data-sortable-item]");
                    if (!targetItem || targetItem === draggedItem || targetItem.parentElement !== container)
                        return;

                    event.preventDefault();
                    const bounds = targetItem.getBoundingClientRect();
                    const insertBefore = event.clientY < bounds.top + bounds.height / 2;
                    container.insertBefore(draggedItem, insertBefore ? targetItem : targetItem.nextElementSibling);
                });

                container.addEventListener("dragend", () => {
                    draggedItem?.classList.remove("opacity-50");
                    draggedItem = null;
                    updateOrder();
                });

                container.addEventListener("items-reordered", updateOrder);
                updateOrder();
            });
        })();
    </script>
</body>

</html>
